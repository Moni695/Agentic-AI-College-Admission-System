# Database Connection String
# For Docker Compose:
# DATABASE_URL=mysql+pymysql://root:root@db:3306/college_admission
# For Local MySQL:
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/college_admission
# For SQLite (zero-setup testing):
# DATABASE_URL=sqlite:///college_admission.db

# JWT Secret Key (Generate a random string for production: `openssl rand -hex 32`)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Server Host & Port (PaaS platforms like Render/Railway automatically inject PORT)
HOST=0.0.0.0
PORT=8000

# OpenAI API Key (Optional: rule-based engine is used if omitted)
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Application Fee Amount (in INR)
APPLICATION_FEE=500.0

# SMTP Email Configuration (Optional: required for sending merit-list congratulation emails)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-google-app-password
# SMTP_FROM_EMAIL=your-email@gmail.com
# SMTP_USE_TLS=true
